# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.eggs/
dist/
build/
*.egg
.cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo

# Machine-local agent state
.agents/work/
.claude/
.codex/
.superpowers/

# sci-brain knowledge base: keep the citable index, drop paper full texts
.knowledge/.raw/
.knowledge/*.md
!.knowledge/INDEX.md
!.knowledge/NOTES.md

# Output files
*.png
*.npy
*.npz
*.h5
*.hdf5
*.parquet
*.pkl
*.pickle
*.csv
*.db
*.sqlite
*.sqlite3
*.pdf
*.log
data/
examples/results/

# Curated manuscript figures are publication inputs, not numerical payloads.
!manuscripts/figures/**/*.png
!manuscripts/figures/**/*.pdf

# Numerical result payloads are local-only. Track reports, never their data.
results/**
!results/**/
!results/README.md
!results/**/README.md

# OS
.DS_Store
Thumbs.db

# Coverage
.coverage
htmlcov/
coverage.xml

# Pytest
.pytest_cache/

# Local resolver state; CI and documented installs use uv pip, not uv sync.
uv.lock
